{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-ready E-Commerce REST API supporting MySQL and PostgreSQL for React & Angular Frontends",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/database/init-db.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ecommerce",
    "express",
    "typescript",
    "mysql",
    "postgresql",
    "rest-api",
    "angular",
    "react"
  ],
  "author": "VladShrof",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.9.7",
    "pg": "^8.11.5",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  }
}